@page

@using Microsoft.AspNetCore.Mvc.Localization

@model ForgotPasswordModel

@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@inject IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["Zaboravljena šifra"];
    ViewBag.showCookie = false;
    Layout = null;
}

<!DOCTYPE html>
<html lang="bs">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"]</title>


    <link rel="stylesheet"
          href="~/lib/ace/bootstrap.css" />

    <link rel="stylesheet"
          href="~/lib/font-awesome/css/fontawesome.min.css" />

    <link rel="stylesheet"
          href="~/lib/font-awesome/css/regular.min.css" />

    <link rel="stylesheet"
          href="~/lib/font-awesome/css/brands.min.css" />

    <link rel="stylesheet"
          href="~/lib/font-awesome/css/solid.min.css" />

    <link rel="stylesheet"
          href="~/lib/ace/ace.min.css" />

    <link rel="stylesheet"
          href="~/lib/ace/ace-themes.css" />


    <style>

        html,
        body {
            width: 100%;
            min-height: 100%;
            margin: 0;
        }

        body {
            min-height: 100vh;
            font-family: Arial, Helvetica, sans-serif;
            color: #34495e;
            background: radial-gradient( circle at 50% 32%, rgba(255,255,255,1) 0%, rgba(248,251,253,.98) 35%, rgba(237,244,249,.98) 70%, rgba(228,239,247,1) 100% );
        }


        /* =========================================================
                   PAGE
                   ========================================================= */

        .forgot-page {
            position: relative;
            width: 100%;
            min-height: 100vh;
            overflow: hidden;
            display: flex;
            justify-content: center;
        }


            .forgot-page::before {
                content: "";
                position: absolute;
                width: 650px;
                height: 650px;
                left: -330px;
                top: -170px;
                border-radius: 50%;
                background: radial-gradient( circle, rgba(25,118,189,.09) 0%, rgba(25,118,189,.025) 48%, transparent 70% );
                pointer-events: none;
            }


            .forgot-page::after {
                content: "";
                position: absolute;
                width: 750px;
                height: 750px;
                right: -390px;
                bottom: -310px;
                border-radius: 50%;
                background: radial-gradient( circle, rgba(25,118,189,.10) 0%, rgba(25,118,189,.025) 50%, transparent 70% );
                pointer-events: none;
            }


        /* =========================================================
                   WRAPPER
                   ========================================================= */

        .forgot-wrapper {
            position: relative;
            z-index: 2;
            width: 100%;
            max-width: 500px;
            padding: 11vh 25px 80px 25px;
        }


        /* =========================================================
                   LOGO
                   ========================================================= */

        .cik-logo {
            width: 100%;
            margin-bottom: 38px;
            text-align: center;
        }


            .cik-logo img {
                display: block;
                width: 100%;
                max-width: 470px;
                height: auto;
                margin: 0 auto;
            }


        /* =========================================================
                   TITLE
                   ========================================================= */

        .forgot-title {
            display: flex;
            align-items: center;
            margin-bottom: 8px;
            color: #34495e;
            font-size: 21px;
            font-weight: 400;
        }


        .forgot-title-icon {
            margin-right: 10px;
            color: #f39c12;
            font-size: 19px;
        }


        .forgot-title::after {
            content: "";
            flex: 1;
            height: 1px;
            margin-left: 15px;
            background: #d5e0e8;
        }


        .forgot-subtitle {
            margin-bottom: 22px;
            color: #7d919f;
            font-size: 12px;
            line-height: 1.5;
        }


        /* =========================================================
                   FORM
                   ========================================================= */

        .forgot-form-group {
            position: relative;
            margin-bottom: 18px;
        }


        .forgot-input-wrapper {
            position: relative;
        }


        .forgot-input-icon {
            position: absolute;
            left: 16px;
            top: 50%;
            transform: translateY(-50%);
            color: #a8b6c2;
            font-size: 14px;
            z-index: 2;
        }


        .forgot-input {
            width: 100%;
            height: 50px;
            padding: 0 15px 0 43px;
            box-sizing: border-box;
            background: rgba(255,255,255,.96);
            border: 1px solid #ccd8e1;
            border-radius: 4px;
            color: #34495e;
            font-size: 15px;
            outline: none;
            box-shadow: 0 2px 6px rgba(30,70,100,.025);
            transition: border-color .15s ease, box-shadow .15s ease, background .15s ease;
        }


            .forgot-input::placeholder {
                color: #98a8b5;
            }


            .forgot-input:focus {
                background: #fff;
                border-color: #2780b9;
                box-shadow: 0 0 0 3px rgba(39,128,185,.08);
            }


        /* =========================================================
                   VALIDATION
                   ========================================================= */

        .field-validation-error {
            display: block;
            margin-top: 4px;
            color: #d84b59;
            font-size: 11px;
        }


        .forgot-validation {
            margin-bottom: 10px;
            color: #d84b59;
            font-size: 12px;
        }


        /* =========================================================
                   BUTTON
                   ========================================================= */

        .forgot-button {
            width: 100%;
            height: 46px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #1976bd;
            border: 1px solid #1976bd;
            border-radius: 4px;
            color: #fff;
            font-size: 15px;
            font-weight: 500;
            cursor: pointer;
            transition: background .15s ease, border-color .15s ease, box-shadow .15s ease;
        }


            .forgot-button:hover {
                background: #14689f;
                border-color: #14689f;
                box-shadow: 0 5px 14px rgba(25,118,189,.18);
            }


            .forgot-button i {
                margin-right: 7px;
            }


        /* =========================================================
                   BACK TO LOGIN
                   ========================================================= */

        .back-login {
            margin-top: 15px;
            text-align: center;
        }


            .back-login a {
                color: #1976bd;
                font-size: 13px;
                text-decoration: none;
            }


                .back-login a:hover {
                    text-decoration: underline;
                }


        /* =========================================================
                   FOOTER
                   ========================================================= */

        .forgot-footer {
            position: absolute;
            left: 0;
            right: 0;
            bottom: 24px;
            z-index: 2;
            text-align: center;
            color: #8296a6;
            font-size: 11px;
        }


        .forgot-footer-title {
            margin-bottom: 3px;
            color: #607b8f;
            font-size: 12px;
            font-weight: 500;
        }


        /* =========================================================
                   RESPONSIVE
                   ========================================================= */

        @@media (max-width: 600px) {

            .forgot-wrapper {
                max-width: 430px;
                padding-top: 8vh;
                padding-left: 20px;
                padding-right: 20px;
            }

            .cik-logo {
                margin-bottom: 30px;
            }

                .cik-logo img {
                    max-width: 410px;
                }

            .forgot-title {
                font-size: 18px;
            }

            .forgot-footer {
                position: relative;
                margin-top: 30px;
                bottom: auto;
            }
        }

    </style>

</head>


<body>


    <div class="forgot-page">


        <div class="forgot-wrapper">


            <!-- LOGO -->

            <div class="cik-logo">

                <img src="~/images/logo.png"
                     alt="Centralna izborna komisija Bosne i Hercegovine" />

            </div>


            <!-- TITLE -->

            <div class="forgot-title">

                <span class="forgot-title-icon">
                    <i class="fa fa-key"></i>
                </span>

                <span>
                    @Localizer["Zaboravljena šifra"]
                </span>

            </div>


            <div class="forgot-subtitle">
                @Localizer["Unesite e-mail adresu povezanu sa korisničkim nalogom."]
            </div>


            <!-- FORM -->

            <form autocomplete="off"
                  id="account"
                  method="post">


                <div asp-validation-summary="ModelOnly"
                     class="forgot-validation">
                </div>


                <div class="forgot-form-group">

                    <div class="forgot-input-wrapper">

                        <i class="fa fa-envelope forgot-input-icon"></i>

                        <input asp-for="Input.Email"
                               id="id-login-username"
                               class="forgot-input"
                               placeholder="@Localizer["E-mail"]"
                               autocomplete="username"
                               aria-required="true" />

                    </div>

                    <span asp-validation-for="Input.Email"
                          class="field-validation-error">
                    </span>

                </div>


                <button id="login-submit"
                        type="submit"
                        class="forgot-button">

                    <i class="fa fa-paper-plane"></i>

                    @Localizer["Promjena šifre"]

                </button>


                <div class="back-login">

                    <a asp-area="Identity"
                       asp-page="/Account/Login">

                        <i class="fa fa-arrow-left mr-1"></i>

                        @Localizer["Povratak na prijavu"]

                    </a>

                </div>

            </form>

        </div>


        <!-- FOOTER -->

        <div class="forgot-footer">

            <div class="forgot-footer-title">
                @Localizer["Centralna izborna komisija Bosne i Hercegovine"]
            </div>

            <div>
                © @DateTime.Now.Year
            </div>

        </div>

    </div>


    <script src="~/lib/ace/jquery.js"></script>

    <script src="~/lib/ace/bootstrap.js"></script>

    <partial name="_ValidationScriptsPartial" />


</body>

</html>