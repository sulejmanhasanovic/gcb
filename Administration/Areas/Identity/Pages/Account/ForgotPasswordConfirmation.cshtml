@page

@using Microsoft.AspNetCore.Mvc.Localization

@model ForgotPasswordConfirmation

@inject IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["Promjena šifre"];
    Layout = null;
}

<!DOCTYPE html>
<html lang="bs">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"]</title>

    <link rel="stylesheet" href="~/lib/ace/bootstrap.css" />

    <link rel="stylesheet" href="~/lib/font-awesome/css/fontawesome.min.css" />
    <link rel="stylesheet" href="~/lib/font-awesome/css/regular.min.css" />
    <link rel="stylesheet" href="~/lib/font-awesome/css/brands.min.css" />
    <link rel="stylesheet" href="~/lib/font-awesome/css/solid.min.css" />

    <link rel="stylesheet" href="~/lib/ace/ace.min.css" />
    <link rel="stylesheet" href="~/lib/ace/ace-themes.css" />


    <style>

        html,
        body {
            width: 100%;
            min-height: 100%;
            margin: 0;
        }

        body {
            min-height: 100vh;
            font-family: Arial, Helvetica, sans-serif;
            color: #34495e;
            background: radial-gradient( circle at 50% 32%, rgba(255,255,255,1) 0%, rgba(248,251,253,.98) 35%, rgba(237,244,249,.98) 70%, rgba(228,239,247,1) 100% );
        }


        /* =========================================================
                   PAGE
                   ========================================================= */

        .confirmation-page {
            position: relative;
            width: 100%;
            min-height: 100vh;
            overflow: hidden;
            display: flex;
            justify-content: center;
        }


            .confirmation-page::before {
                content: "";
                position: absolute;
                width: 650px;
                height: 650px;
                left: -330px;
                top: -170px;
                border-radius: 50%;
                background: radial-gradient( circle, rgba(25,118,189,.09) 0%, rgba(25,118,189,.025) 48%, transparent 70% );
                pointer-events: none;
            }


            .confirmation-page::after {
                content: "";
                position: absolute;
                width: 750px;
                height: 750px;
                right: -390px;
                bottom: -310px;
                border-radius: 50%;
                background: radial-gradient( circle, rgba(25,118,189,.10) 0%, rgba(25,118,189,.025) 50%, transparent 70% );
                pointer-events: none;
            }


        /* =========================================================
                   WRAPPER
                   ========================================================= */

        .confirmation-wrapper {
            position: relative;
            z-index: 2;
            width: 100%;
            max-width: 500px;
            padding: 11vh 25px 80px 25px;
        }


        /* =========================================================
                   LOGO
                   ========================================================= */

        .cik-logo {
            width: 100%;
            margin-bottom: 38px;
            text-align: center;
        }


            .cik-logo img {
                display: block;
                width: 100%;
                max-width: 470px;
                height: auto;
                margin: 0 auto;
            }


        /* =========================================================
                   TITLE
                   ========================================================= */

        .confirmation-title {
            display: flex;
            align-items: center;
            margin-bottom: 20px;
            color: #34495e;
            font-size: 21px;
            font-weight: 400;
        }


        .confirmation-title-icon {
            margin-right: 10px;
            color: #f39c12;
            font-size: 19px;
        }


        .confirmation-title::after {
            content: "";
            flex: 1;
            height: 1px;
            margin-left: 15px;
            background: #d5e0e8;
        }


        /* =========================================================
                   MESSAGE
                   ========================================================= */

        .confirmation-message {
            padding: 22px 22px;
            display: flex;
            align-items: flex-start;
            background: rgba(255,255,255,.82);
            border: 1px solid #d6e2ea;
            border-radius: 5px;
            box-shadow: 0 4px 15px rgba(30,70,100,.05);
        }


        .confirmation-message-icon {
            flex: 0 0 42px;
            width: 42px;
            height: 42px;
            margin-right: 15px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            background: #e7f4ec;
            color: #29945f;
            font-size: 18px;
        }


        .confirmation-message-content {
            flex: 1;
        }


        .confirmation-message-title {
            margin: 1px 0 5px 0;
            color: #34495e;
            font-size: 15px;
            font-weight: 600;
        }


        .confirmation-message-text {
            margin: 0;
            color: #667f91;
            font-size: 13px;
            line-height: 1.55;
        }


        /* =========================================================
                   BACK TO LOGIN
                   ========================================================= */

        .back-login {
            margin-top: 18px;
            text-align: center;
        }


            .back-login a {
                color: #1976bd;
                font-size: 13px;
                text-decoration: none;
            }


                .back-login a:hover {
                    text-decoration: underline;
                }


        /* =========================================================
                   FOOTER
                   ========================================================= */

        .confirmation-footer {
            position: absolute;
            left: 0;
            right: 0;
            bottom: 24px;
            z-index: 2;
            text-align: center;
            color: #8296a6;
            font-size: 11px;
        }


        .confirmation-footer-title {
            margin-bottom: 3px;
            color: #607b8f;
            font-size: 12px;
            font-weight: 500;
        }


        /* =========================================================
                   RESPONSIVE
                   ========================================================= */

        @@media (max-width: 600px) {

            .confirmation-wrapper {
                max-width: 430px;
                padding-top: 8vh;
                padding-left: 20px;
                padding-right: 20px;
            }

            .cik-logo {
                margin-bottom: 30px;
            }

                .cik-logo img {
                    max-width: 410px;
                }

            .confirmation-title {
                font-size: 18px;
            }

            .confirmation-message {
                padding: 18px;
            }

            .confirmation-footer {
                position: relative;
                margin-top: 30px;
                bottom: auto;
            }
        }

    </style>

</head>


<body>


    <div class="confirmation-page">


        <div class="confirmation-wrapper">


            <!-- LOGO -->

            <div class="cik-logo">

                <img src="~/images/logo.png"
                     alt="Centralna izborna komisija Bosne i Hercegovine" />

            </div>


            <!-- TITLE -->

            <div class="confirmation-title">

                <span class="confirmation-title-icon">
                    <i class="fa fa-key"></i>
                </span>

                <span>
                    @Localizer["Promjena šifre"]
                </span>

            </div>


            <!-- MESSAGE -->

            <div class="confirmation-message">

                <div class="confirmation-message-icon">
                    <i class="fa fa-envelope"></i>
                </div>


                <div class="confirmation-message-content">

                    <div class="confirmation-message-title">
                        @Localizer["Poruka je poslana"]
                    </div>

                    <p class="confirmation-message-text">
                        @Localizer["Provjerite poruku koju ste dobili na email koji ste upisali"]
                    </p>

                </div>

            </div>


            <!-- BACK -->

            <div class="back-login">

                <a asp-area="Identity"
                   asp-page="/Account/Login">

                    <i class="fa fa-arrow-left mr-1"></i>

                    @Localizer["Povratak na prijavu"]

                </a>

            </div>


        </div>


        <!-- FOOTER -->

        <div class="confirmation-footer">

            <div class="confirmation-footer-title">
                @Localizer["Centralna izborna komisija Bosne i Hercegovine"]
            </div>

            <div>
                © @DateTime.Now.Year
            </div>

        </div>


    </div>


    <script src="~/lib/ace/jquery.js"></script>
    <script src="~/lib/ace/bootstrap.js"></script>


</body>

</html>