<script type="text/javascript">
    var url = {
        UpdateUser: '@Url.Action("UpdateUser", "Admin")',
        InsertUser: '@Url.Action("InsertUser", "Admin")',
        DeleteUser: '@Url.Action("DeleteUser", "Admin")',
        CreateMecAdmins: '@Url.Action("CreateMecAdmins", "Admin")',
        GetPRPUsers: '@Url.Action("GetPRPUsers", "Admin")',
        GetBOOUsers: '@Url.Action("GetBOOUsers", "Admin")',
