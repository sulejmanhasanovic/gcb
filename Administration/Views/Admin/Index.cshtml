@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.AspNetCore.Localization
@using Newtonsoft.Json
@inject IViewLocalizer Localizer
@model IEnumerable<Administration.Models.AspNetUser>

@{
    ViewData["Title"] = "Administracija";
    var visible = true;
    var psActive = "";
    var candActive = "";
    var prpActive = "";
    var booActive = "";
    var boActive = "";
    var obsActive = "";
    var mecActive = "";
    var comActive = "";
    if (User.IsInRole("IM_Admin") || User.IsInRole("PS_Admin")) { psActive = "active"; }
    if (User.IsInRole("CAND_Admin")) { candActive = "active"; }
    if (User.IsInRole("PRP_Admin")) { prpActive = "active"; }
    if (User.IsInRole("BOO_Admin")) { booActive = "active"; }
    if (User.IsInRole("BO_Admin")) { boActive = "active"; }
    if (User.IsInRole("OBS_Admin")) { obsActive = "active"; }
    if (User.IsInRole("COM_Admin")) { comActive = "active"; }
    if (User.IsInRole("MEC_Admin"))
    {
        visible = false;
        mecActive = "active";
    }
}

@{
    List<object> commands = new List<object>();
    commands.Add(new { type = "ChangePass", buttonOption = new { iconCss = "e-icons fa fa-key fa-lg text-info", cssClass = "e-flat" } }); // custom
    commands.Add(new { type = "Edit", buttonOption = new { iconCss = "e-icons e-edit", cssClass = "e-flat primary" } });
    commands.Add(new { type = "Save", buttonOption = new { iconCss = "e-icons e-update", cssClass = "e-flat update-user" } });
    commands.Add(new { type = "Cancel", buttonOption = new { iconCss = "e-icons e-cancel-icon", cssClass = "e-flat" } });
    commands.Add(new { type = "Delete", buttonOption = new { iconCss = "e-icons e-delete text-danger", cssClass = "e-flat" } });

    var requestCulture = Context.Features.Get<IRequestCultureFeature>();

    List<object> toolbarItems = new List<object>();
    toolbarItems.Add(new { text = @Localizer["Novi korisnik"].Value, tooltipText = @Localizer["Novi korisnik"].Value, prefixIcon = "e-add" });
    // toolbarItems.Add(new { text = @Localizer["Novi korisnik"].Value, tooltipText = @Localizer["Novi korisnik"].Value, prefixIcon = "e-add", id = "add" });
    // toolbarItems.Add(new { text = @Localizer["Promjena šifre"].Value, tooltipText = @Localizer["Promjena šifre"].Value, prefixIcon = "e-edit", id = "resetpassword" });
    toolbarItems.Add(new { text = "Search", align = "right", tooltipText = "Search", prefixIcon = "e-expand", id = "expandall" });

    //var DropDownListRoles = new Syncfusion.EJ2.DropDowns.DropDownList() { DataSource = ViewBag.rolesPS, Query = "new ej.data.Query()", AllowFiltering = true, Fields = new Syncfusion.EJ2.DropDowns.DropDownListFieldSettings() { Value = "Value", Text = "Text" } };
    // var DropDownListParties = new Syncfusion.EJ2.DropDowns.DropDownList() { DataSource = ViewBag.parties1, Query = "new ej.data.Query()", AllowFiltering = true, Fields = new Syncfusion.EJ2.DropDowns.DropDownListFieldSettings() { Value = "Value", Text = "Text" } };
    // var DropDownListObservers = new Syncfusion.EJ2.DropDowns.DropDownList() { DataSource = ViewBag.observers1, Query = "new ej.data.Query()", AllowFiltering = true, Fields = new Syncfusion.EJ2.DropDowns.DropDownListFieldSettings() { Value = "Value", Text = "Text" } };

    var defaultanimation = new Syncfusion.EJ2.Popups.DialogAnimationSettings { Effect = Syncfusion.EJ2.Popups.DialogEffect.FadeZoom };
