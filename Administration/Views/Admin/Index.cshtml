<script>

    function onfilteringroles(e) {
        var query = new ej.data.Query();
        query = (e.text !== '') ? query.where('Name', 'contains', e.text, true) : query;
        e.updateData(@Html.Raw(JsonConvert.SerializeObject(ViewBag.roles)), query);
    }

    function onfilteringparties(e) {
        var query = new ej.data.Query();
        query = (e.text !== '') ? query.where('NameOnballot', 'contains', e.text, true) : query;
        e.updateData(@Html.Raw(JsonConvert.SerializeObject(ViewBag.parties)), query);
    }

    function onfilteringobservers(e) {
        var query = new ej.data.Query();
        query = (e.text !== '') ? query.where('Name', 'contains', e.text, true) : query;
        e.updateData(@Html.Raw(JsonConvert.SerializeObject(ViewBag.observers)), query);
    }
</script>