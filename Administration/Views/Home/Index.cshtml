            <div class="col-xl-7 col-lg-9 text-center mt70">

               @*  <h6>@localizer["Dobrodošli na portal e-Izbori Centralne izborne komisije Bosne i Hercegovine"]</h6> *@
                <h1><span><b><i style="font-size:larger">e</i></b></span>-@localizer["Izbori"]</h1>
            </div>
        </div>

