@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer localizer
@using Microsoft.AspNetCore.Localization

@{
    var requestCulture = Context.Features.Get<IRequestCultureFeature>();
    var showCookie = (ViewBag.showCookie == null) ? true : false;
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />

    <title>@localizer["Centralna izborna komisija"]</title>

    <meta content="" name="description" />
    <meta content="" name="keywords" />


    <!-- =========================================================
         CSS
         ========================================================= -->

    <link rel="stylesheet" href="~/lib/ace/bootstrap.css" />

    <link rel="stylesheet" href="~/css/ej2/material.css" />

    <link rel="stylesheet" href="~/lib/ace/ace-themes.css" />


    <link rel="stylesheet" href="~/lib/font-awesome/css/fontawesome.min.css" />

    <link rel="stylesheet" href="~/lib/font-awesome/css/regular.min.css" />

    <link rel="stylesheet" href="~/lib/font-awesome/css/brands.min.css" />

    <link rel="stylesheet" href="~/lib/font-awesome/css/solid.min.css" />


    <link rel="stylesheet" href="~/lib/ace/ace.min.css" />

    <link rel="stylesheet" href="~/css/preloader.css" />


    <style>

        :root {
            --admin-primary: #17658e;
            --admin-primary-light: #e8f4fb;
            --admin-primary-hover: #126fa7;

            --admin-page: #f5f8fa;
            --admin-white: #ffffff;

            --admin-text: #34495e;
            --admin-text-light: #536c7d;

            --admin-muted: #7d919f;

            --admin-border: #dce5eb;
        }


        /* =========================================================
           GLOBAL
           ========================================================= */

        html,
        body {
            min-height: 100%;
        }

        body {
            margin: 0;

            background: var(--admin-page) !important;

            color: var(--admin-text);
        }


        .main-container,
        .main-content {
            background: var(--admin-page) !important;
        }


        /* =========================================================
           TOP NAVIGATION
           ========================================================= */

        .admin-navbar {
            position: relative;
            z-index: 100;

            width: 100%;
            height: 68px;

            display: flex;
            align-items: center;

            padding: 0 30px;

            background: #ffffff;

            border-top: 3px solid var(--admin-primary);

            border-bottom: 1px solid #d7e3eb;

            box-shadow:
                0 4px 14px rgba(31, 72, 100, .10);
        }


        /* =========================================================
           BRAND
           ========================================================= */

        .admin-brand {
            height: 38px;

            display: flex;
            align-items: center;

            margin-right: 35px;
            padding-right: 35px;

            border-right: 1px solid var(--admin-border);

            color: #254c65;

            font-size: 18px;
            font-weight: 600;

            white-space: nowrap;
        }


        .admin-brand-icon {
            width: 36px;
            height: 36px;

            display: flex;
            align-items: center;
            justify-content: center;

            margin-right: 10px;

            border-radius: 7px;

            background: var(--admin-primary-light);

            color: var(--admin-primary);

            font-size: 16px;
        }


        /* =========================================================
           NAVIGATION LINKS
           ========================================================= */

        .admin-nav {
            height: 100%;

            display: flex;
            align-items: stretch;
        }


        .admin-nav-link {
            position: relative;

            display: flex;
            align-items: center;

            height: 100%;

            padding: 0 19px;

            color: var(--admin-text-light);

            font-size: 14px;
            font-weight: 500;

            text-decoration: none !important;

            transition:
                color .15s ease,
                background .15s ease;
        }


        .admin-nav-link i {
            width: 18px;

            margin-right: 7px;

            color: #7897aa;

            text-align: center;

            transition: color .15s ease;
        }


        .admin-nav-link:hover {
            color: var(--admin-primary-hover);

            background: #f2f8fc;
        }


        .admin-nav-link:hover i {
            color: #1684c5;
        }


        /* ACTIVE */

        .admin-nav-link.active {
            color: var(--admin-primary-hover);

            background: #f4f9fc;

            font-weight: 600;
        }


        .admin-nav-link.active i {
            color: #1684c5;
        }


        .admin-nav-link.active::after {
            content: "";

            position: absolute;

            left: 15px;
            right: 15px;
            bottom: 0;

            height: 3px;

            background: #1684c5;

            border-radius: 3px 3px 0 0;
        }


        /* =========================================================
           NAVBAR RIGHT SIDE
           ========================================================= */

        .admin-navbar-right {
            display: flex;
            align-items: center;

            gap: 24px;

            margin-left: auto;
        }


        .admin-language {
            min-width: 180px;
        }


        /* USER */

        .admin-user {
            position: relative;
            display: flex;
            align-items: center;
            height: 64px;
            padding-left: 18px;
            border-left: 1px solid #e0e7ec;
        }


            .admin-user .top-user-menu {
                position: relative;
                height: 100%;
                display: flex;
                align-items: center;
            }


            .admin-user .top-user-toggle {
                height: 100%;
                display: flex;
                align-items: center;
                padding: 0 12px;
                background: transparent !important;
                border: 0 !important;
                outline: none !important;
                box-shadow: none !important;
                cursor: pointer;
            }


            .admin-user .top-user-image {
                display: block !important;
                width: 38px !important;
                min-width: 38px !important;
                max-width: 38px !important;
                height: 38px !important;
                min-height: 38px !important;
                max-height: 38px !important;
                margin: 0 10px 0 0 !important;
                padding: 0 !important;
                border: 0 !important;
                border-radius: 50% !important;
                object-fit: cover !important;
            }


            .admin-user .top-user-name {
                display: block;
                max-width: 220px;
                overflow: hidden;
                text-overflow: ellipsis;
                color: #1767b0;
                font-size: 13px;
                font-weight: 500;
                white-space: nowrap;
            }


            .admin-user .top-user-arrow {
                margin-left: 9px;
                color: #71899a;
                font-size: 11px;
                transition: transform .15s ease;
            }


            .admin-user .top-user-menu.open .top-user-arrow {
                transform: rotate(180deg);
            }


            /* DROPDOWN */

            .admin-user .top-user-dropdown {
                position: absolute;
                top: calc(100% + 1px);
                right: 0;
                width: 200px;
                display: none;
                padding: 6px 0;
                background: #fff;
                border: 1px solid #dce5eb;
                border-radius: 7px;
                box-shadow: 0 8px 24px rgba(30, 70, 100, .14);
                z-index: 9999;
            }


            .admin-user .top-user-menu.open .top-user-dropdown {
                display: block;
            }


            .admin-user .top-user-item {
                width: 100%;
                display: flex;
                align-items: center;
                padding: 10px 14px;
                background: transparent !important;
                border: 0 !important;
                color: #466177;
                font-size: 13px;
                text-align: left;
                text-decoration: none !important;
                cursor: pointer;
            }


                .admin-user .top-user-item i {
                    width: 20px;
                    margin-right: 8px;
                    text-align: center;
                }


                .admin-user .top-user-item:hover {
                    background: #f2f8fc !important;
                    color: #176fae;
                }


            .admin-user .top-user-divider {
                height: 1px;
                margin: 5px 0;
                background: #e6edf2;
            }


            .admin-user .top-user-dropdown form {
                margin: 0 !important;
                padding: 0 !important;
            }


        /* =========================================================
           MESSAGES
           ========================================================= */

        #msg-danger,
        #msg-warning,
        #msg-info,
        #msg-success {
            position: relative;
            z-index: 50;
        }


        /* =========================================================
           PAGE CONTENT
           ========================================================= */

        .admin-content {
            width: 100%;
            padding: 28px 40px 45px 40px;
            background: var(--admin-page);
        }

        .admin-content-inner {
            width: 100%;
            max-width: none;
            margin: 0;
        }

        /* =========================================================
           DASHBOARD
           ========================================================= */
        .dashboard-home {
            display: grid;
            grid-template-columns: 365px minmax(0, 1fr);
            gap: 28px;
            width: 100%;
        }

        .dashboard-page {
            padding-top: 0;
            padding-bottom: 30px;
        }


        .dashboard-top-section {
            margin-bottom: 30px;
        }


        .dashboard-heading-subtitle {
            margin-bottom: 14px;

            color: #59738a;

            font-size: 14px;
            font-weight: 500;
        }


        /* APPLICATION CARDS */

        .admin-app-grid {
            display: grid;

            grid-template-columns:
                repeat(auto-fill, minmax(300px, 335px));

            gap: 16px;
        }


        .admin-app-card {
            position: relative;

            display: flex;
            align-items: center;

            min-height: 102px;

            padding: 17px 18px;

            background: #fff;

            border: 1px solid #dce6ee;

            border-top: 4px solid #1976bd;

            border-radius: 8px;

            text-decoration: none !important;

            box-shadow:
                0 4px 14px rgba(30, 75, 105, .05);

            transition:
                transform .15s ease,
                box-shadow .15s ease,
                border-color .15s ease;
        }


        .admin-app-card:hover {
            transform: translateY(-2px);

            border-color: #c6d8e5;

            border-top-color: #12659f;

            box-shadow:
                0 8px 20px rgba(30, 75, 105, .10);
        }


        .admin-app-icon {
            width: 52px;
            min-width: 52px;
            height: 52px;

            display: flex;
            align-items: center;
            justify-content: center;

            margin-right: 15px;

            border-radius: 9px;

            background: #e8f3fa;

            color: #1976bd;

            font-size: 23px;
        }


        .admin-app-info {
            flex: 1;

            min-width: 0;
        }


        .admin-app-title {
            margin-bottom: 4px;

            color: #1474b8;

            font-size: 15px;
            font-weight: 600;
        }


        .admin-app-description {
            color: #70879a;

            font-size: 12px;
            line-height: 1.45;

            display: -webkit-box;

            -webkit-line-clamp: 2;

            -webkit-box-orient: vertical;

            overflow: hidden;
        }


        .admin-app-arrow {
            margin-left: 10px;

            color: #a8b6c1;

            font-size: 11px;

            transition: .15s ease;
        }


        .admin-app-card:hover .admin-app-arrow {
            transform: translateX(2px);

            color: #1976bd;
        }


        /* =========================================================
           RESPONSIVE
           ========================================================= */

        @@media (max-width: 1050px) {

            .admin-brand {
                margin-right: 15px;
                padding-right: 15px;
            }


            .admin-nav-link {
                padding: 0 12px;
            }


            .admin-language {
                min-width: 140px;
            }

        }


        @@media (max-width: 850px) {

            .admin-navbar {
                padding: 0 15px;
            }


            .admin-brand span {
                display: none;
            }


            .admin-brand {
                margin-right: 5px;
                padding-right: 12px;
            }


            .admin-nav-link {
                padding: 0 10px;
            }


            .admin-nav-link i {
                margin-right: 4px;
            }


            .admin-language {
                display: none;
            }


            .admin-content {
                padding: 20px 15px 35px 15px;
            }

        }


        @@media (max-width: 620px) {

            .admin-navbar {
                height: 62px;
            }


            .admin-brand {
                display: none;
            }


            .admin-nav-link {
                padding: 0 9px;

                font-size: 12px;
            }


            .admin-nav-link i {
                font-size: 13px;
            }


            .admin-user {
                display: flex;
                align-items: center;
                min-height: 48px;
                padding-left: 22px;
                border-left: 1px solid #e0e7ec;
            }

                .admin-user .nav {
                    margin: 0 !important;
                    padding: 0 !important;
                }

                .admin-user .nav-item {
                    margin: 0 !important;
                }

                .admin-user .nav-link {
                    min-height: 48px;
                    display: flex !important;
                    align-items: center !important;
                    padding: 0 6px !important;
                    color: #34566d !important;
                    text-decoration: none !important;
                }

                .admin-user .dropdown-toggle::after {
                    margin-left: 9px !important;
                    vertical-align: middle !important;
                }

                .admin-user .dropdown-menu {
                    margin-top: 8px !important;
                    border: 1px solid #dce5eb;
                    border-radius: 7px;
                    box-shadow: 0 8px 24px rgba(30, 70, 100, .12);
                }


            .admin-app-grid {
                grid-template-columns: 1fr;
            }

        }

    </style>


    <!-- =========================================================
         JS
         ========================================================= -->

    <script src="~/js/jquery.globalize.min.js"></script>

    <script src="~/js/ej2/ej2.min.js"></script>

    <script src="~/lib/ace/jquery.js"></script>
    <script src="~/lib/popper/popper.js"></script>
    <script src="~/lib/ace/bootstrap.js"></script>


    <script src="~/js/globalize.culture.bs-Latn-BA.min.js"></script>

    <script src="~/js/globalize.culture.hr-BA.min.js"></script>

    <script src="~/js/globalize.culture.bs-Cyrl-BA.min.js"></script>

</head>


<body>


    <!-- =============================================================
         PRELOADER
         ============================================================= -->

    <div id="preloader" style="display:none">
        <div></div>
    </div>



    <!-- =============================================================
         TOP NAVBAR
         ============================================================= -->

    <header class="admin-navbar">


        <!-- BRAND -->

        <div class="admin-brand">

            <div class="admin-brand-icon">

                <i class="fa fa-cogs"></i>

            </div>

            <span>

                @localizer["Administracija"]

            </span>

        </div>



        <!-- =========================================================
             NAVIGATION
             ========================================================= -->

        <nav class="admin-nav">


            <!-- POČETNA -->

            <a asp-controller="Dashboard"
               asp-action="Index"
               class="admin-nav-link">

                <i class="fa fa-home"></i>

                <span>
                    @localizer["Početna"]
                </span>

            </a>



            <!-- APLIKACIJE -->

            @if (User.IsInRole("IM_Admin"))
            {
                <a asp-controller="Application"
                   asp-action="Index"
                   class="admin-nav-link">

                    <i class="fa fa-cubes"></i>

                    <span>
                        @localizer["Aplikacije"]
                    </span>

                </a>
            }



            <!-- KORISNICI -->

            @if (
                User.IsInRole("IM_Admin") ||
                User.IsInRole("PS_Admin") ||
                User.IsInRole("CAND_Admin") ||
                User.IsInRole("COM_Admin") ||
                User.IsInRole("OBS_Admin") ||
                User.IsInRole("PRP_Admin") ||
                User.IsInRole("BO_Admin") ||
                User.IsInRole("MEC_Admin")
            )
            {
                <a asp-controller="Admin"
                   asp-action="Index"
                   class="admin-nav-link">

                    <i class="fa fa-users"></i>

                    <span>
                        @localizer["Korisnici"]
                    </span>

                </a>
            }

        </nav>



        <!-- =========================================================
             RIGHT SIDE
             ========================================================= -->

        <div class="admin-navbar-right">


            <!-- LANGUAGE -->

            <div class="admin-language">

                @await Html.PartialAsync("_SelectLanguagePartial")

            </div>



            <!-- USER -->

            <div class="admin-user">

                    @await Html.PartialAsync("_LoginPartial")

            </div>

        </div>

    </header>



    <!-- =============================================================
         MESSAGES
         ============================================================= -->

    <div id="msg-danger"></div>

    <div id="msg-warning"></div>

    <div id="msg-info"></div>

    <div id="msg-success"></div>



    <!-- =============================================================
         CONTENT
         ============================================================= -->

    <main class="admin-content">

        <div class="admin-content-inner">

            @RenderBody()

        </div>

    </main>



    <!-- =============================================================
         SCRIPTS
         ============================================================= -->

    <script src="~/lib/ace/ace.js"></script>

    <script src="~/js/app/app-messages.js"></script>


    <ejs-scripts></ejs-scripts>


    @await RenderSectionAsync("Scripts", required: false)



    <!-- =============================================================
         ACTIVE MENU
         ============================================================= -->

    <script>

    $(function () {

    var controller = '@ViewContext.RouteData.Values["controller"]'.toLowerCase();
    var action = '@ViewContext.RouteData.Values["action"]'.toLowerCase();

    $('.admin-nav-link').each(function () {

        var href = $(this).attr('href');

        if (!href)
            return;

        href = href.toLowerCase();

        if (
            controller === 'dashboard' &&
            action === 'index' &&
            href.indexOf('/dashboard') >= 0
        ) {
            $(this).addClass('active');
            return;
        }

        if (
            controller === 'application' &&
            href.indexOf('/application') >= 0
        ) {
            $(this).addClass('active');
            return;
        }

        if (
            controller === 'admin' &&
            href.indexOf('/admin') >= 0
        ) {
            $(this).addClass('active');
        }
    });
});

        (function () {

            function initUserDropdown() {

                var toggle = document.getElementById('topUserToggle');
                var menu = document.querySelector('.top-user-menu');
                var dropdown = document.getElementById('topUserDropdown');

                if (!toggle || !menu)
                    return;

                toggle.addEventListener('click', function (e) {
                    e.preventDefault();
                    e.stopPropagation();
                    menu.classList.toggle('open');
                });

                if (dropdown) {
                    dropdown.addEventListener('click', function (e) {
                        e.stopPropagation();
                    });
                }

                document.addEventListener('click', function () {
                    menu.classList.remove('open');
                });

                document.addEventListener('keydown', function (e) {
                    if (e.key === 'Escape') {
                        menu.classList.remove('open');
                    }
                });
            }

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', initUserDropdown);
            }
            else {
                initUserDropdown();
            }

        })();

    </script>


</body>

</html>