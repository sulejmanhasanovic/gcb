@page
@using Microsoft.AspNetCore.Mvc.Localization
@model ForgotPasswordModel
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@inject IViewLocalizer Localizer
@{
    ViewData["Title"] = @Localizer["Zaboravljena šifra"];
}

<div class="container">
	<div class="row-content">
		<div class="col-md-4 offset-md-4">
			<section>
        <form method="post">
            <h4>@Localizer["Zaboravljena šifra"]</h4>
					<hr />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="input-floating-label">
                <input asp-for="Input.Email" class="form-control form-control-lg" autocomplete="username" aria-required="true" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
                        <span class="floating-label text-grey-m3">
                            @Localizer["E-mail"]
                        </span>
            </div>
            <br/>
                    <button type="submit" class="w-100 btn btn-primary h45">@Localizer["Promjena šifre"]</button>
        </form>
        </section>
    </div>
</div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
