@page
@using AspNetCore.ReCaptcha
@using Microsoft.AspNetCore.Mvc.Localization
@model LoginModel
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@inject IViewLocalizer Localizer
@{
    ViewData["Title"] = "Prijava";
}

<div class="container">
    <div class="row-content">
        <div class="col-md-4 offset-md-4 mt-5">
            <section>

            <form id="account" method="post">
                <h4>@Localizer["Prijava"] </h4>
                <hr />
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="input-floating-label">
                        <input asp-for="Input.Email" class="form-control form-control-lg" autocomplete="username" aria-required="true" />
                        <span class="floating-label text-grey-m3">
                            @Localizer["E-mail"]
                        </span>
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>
                    <br />
                    <div class="input-floating-label">
                        <input asp-for="Input.Password" class="form-control form-control-lg" autocomplete="current-password" aria-required="true" />
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                        <span class="floating-label text-grey-m3">
                            @Localizer["Šifra"]
                        </span>
                    </div>
                    <br />
                    <div>
                    </div>
                    <div>
                        <button id="login-submit" type="submit" class="w-100 btn btn-primary h45">@Localizer["Prijava"] </button>
                    </div>
                    <br />
                    <div>
                        <a asp-area="Identity" asp-page="/Account/ForgotPassword">@Localizer["Zaboravljena šifra?"]</a>
                    </div>

                    @Html.ReCaptcha()
                    <recaptcha />
                </form>
        </section>
    </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
