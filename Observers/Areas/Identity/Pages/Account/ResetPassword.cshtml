@page
@using Microsoft.AspNetCore.Mvc.Localization
@model ResetPasswordModel
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@inject IViewLocalizer Localizer
@{
    ViewData["Title"] = @Localizer["Promjena šifre"];
}

<div class="container">
	<div class="row-content">
		<div class="col-md-4 offset-md-4">
			<section>
        <form method="post">
                    <h5 class="card-title">@Localizer["Promjena šifre"]</h5>
                    <hr />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input asp-for="Input.Code" type="hidden" />
                        <div class="input-floating-label">
                <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
                            <span class="floating-label text-grey-m3">
                                @Localizer["Email"]
                            </span>
            </div>
            <br/>
                        <div class="input-floating-label">
                <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" />
                <span asp-validation-for="Input.Password" class="text-danger"></span>
                            <span class="floating-label text-grey-m3">
                                @Localizer["Šifra"]
                            </span>
            </div>
            <br/>
                        <div class="input-floating-label">
                <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" />
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                            <span class="floating-label text-grey-m3">
                                @Localizer["Ponovljena šifra"]
                            </span>
            </div>
            <br/>
                        <button type="submit" class="w-100 btn btn-primary h45">@Localizer["Promijeni šifru"]</button>
        </form>
        </section>
    </div>
</div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
