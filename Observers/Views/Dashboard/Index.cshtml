						},
						confirm: {
							label: '<i class="fa fa-times"></i> ' + translations.Delete,
							className: 'btn-success'
						}
					},
					callback: function(result) {
						if (result) {
							$.ajax({
								type: "POST",
								url: url.DeleteDecision,
								data: { Id: accId, decisionId:decisionId }
							})
								.done(function(response) {
									var grid = document.getElementById("gridAODecisions").ej2_instances[0];
									grid.dataSource = response.decisionlist;
									showMessage(translations.SaveDataTitle, translations.SuccessDelete, 'success');
								})
								.fail(function(jqXHR, textStatus) {
									console.log(jqXHR.responseText);
								});
						}
					}
				});
		  }
	}

		function setObserverApprovalHeader(approved, reasonText) {
		const header = document.getElementById("observerHeader");
		const title = document.getElementById("observerHeaderTitle");
		const icon = document.getElementById("observerHeaderIcon");

		if (!header || !title || !icon) return;

		header.classList.remove("header-approved", "header-rejected", "header-neutral");
		icon.innerHTML = ""; // reset

		if (approved === true) {
			header.classList.add("header-approved");
			title.textContent = translations.ApprovedPerson;

			icon.innerHTML = '<i class="fa fa-check-circle"></i>';
		}
		else if (approved === false) {
			header.classList.add("header-rejected");
			title.textContent = reasonText
				? translations.NotApproved+" - " + reasonText
				: translations.NotApproved;

			icon.innerHTML = '<i class="fa fa-times-circle"></i>';
		}
		else {
			header.classList.add("header-neutral");
			title.textContent = translations.NewPerson;

			icon.innerHTML = '<i class="fa fa-plus-circle"></i>';
		}
	}

		function setObserverWarnings(isDuplicate, isCandidate) {

		const dup = document.getElementById("warnDuplicate");
		const cand = document.getElementById("warnCandidate");

		if (!dup || !cand) return;

		dup.style.display = isDuplicate ? "" : "none";
		cand.style.display = isCandidate ? "" : "none";
	}

	
	function getStatusReasonDdl() {
		return document.getElementById("StatusReasonId")?.ej2_instances?.[0] ?? null;
	}

	function clearStatusReasonValidation() {
		const ddlEl = document.getElementById("StatusReasonId");
		if (!ddlEl) return;

		const wrapper = ddlEl.closest(".e-control-wrapper");
		if (wrapper) wrapper.classList.remove("validation-error");

		const msg = document.getElementById("statusReasonValidation");
		if (msg) msg.style.display = "none";
	}

	function markStatusReasonValidation() {
		const ddlEl = document.getElementById("StatusReasonId");
		if (!ddlEl) return;

		const wrapper = ddlEl.closest(".e-control-wrapper");
		if (wrapper) wrapper.classList.add("validation-error");

		const msg = document.getElementById("statusReasonValidation");
		if (msg) msg.style.display = "block";
	}

	function toggleStatusReasonByApproved() {
		const approved = $("#StatusApproved").is(":checked");
		const ddl = getStatusReasonDdl();

		clearStatusReasonValidation();

		if (!ddl) return;

		if (approved) {
			ddl.value = null;
			ddl.text = null;
			ddl.dataBind();
		}
	}

	function saveObserverStatus() {
		var id = parseInt($("#StatusObserverId").val(), 10);
		var approved = $("#StatusApproved").is(":checked");

		var ddl = getStatusReasonDdl();
		var idReason = ddl ? ddl.value : null;

		clearStatusReasonValidation();

		if (!approved && (!idReason || idReason === "")) {
			markStatusReasonValidation();
			showMessage(translations.SaveDataTitle, "Razlog je obavezan kada posmatrač nije odobren.", "danger");
			return;
		}

		if (approved && ddl) {
			ddl.value = null;
			ddl.text = null;
			ddl.dataBind();
			idReason = null;
		}

		$.ajax({
			url: url.UpdateObserverStatus,
			type: 'POST',
			contentType: 'application/json; charset=utf-8',
			data: JSON.stringify({
				id: id,
				approved: approved,
				idReason: idReason
			})
		})
		.done(function (result) {
			if (result.status === "Success") {
				var grid = document.getElementById("gridObservers")?.ej2_instances?.[0];
				if (grid) {
					grid.dataSource = result.observerPersons;
					grid.refresh();
				}

				$("#observerStatusModal").modal("hide");
				showMessage(translations.SaveDataTitle, translations.Success, 'success');
			}
		})
		.fail(function (xhr) {
			console.log(xhr);
			showMessage(translations.SaveDataTitle, "Server error", "danger");
		});
	}

		function setObserverScopeForEdit(row) {
		const scope = getScopeFromRow(row);

		isEditModeScopeSet = true;
		setEjsDropdownValue("ObserverScope", scope);
		isEditModeScopeSet = false;

		$("#pnlFilterMunicipality").hide();
		$("#pnlFilterDkp").hide();

		setEjsDropdownValue("MunicipalityFilter", null);
		setEjsDropdownValue("DkpFilter", null);

		if (scope === "BM") {
			$("#pnlFilterMunicipality").show();
			setEjsDropdownValue("MunicipalityFilter", row.MunicipalitiesId ?? null);
		}

		if (scope === "DKP") {
			$("#pnlFilterDkp").show();
			setEjsDropdownValue("DkpFilter", row.DkpId ?? null);
		}
	}

		function openObserverModalForNew() {
		clearObserverFields();

		$("#observerHeaderTitle").text('@Localizer["Novi posmatrač"]');
		$("#warnDuplicate").hide();
		$("#warnCandidate").hide();

		$("#observerModal").modal("show");

		setTimeout(function () {
			document.getElementById("CountryId")?.ej2_instances?.[0]?.refresh();
			$("#LastName").focus();
		}, 200);
	}

		function openOrganizationRejectDecisionModal() {
		$("#DecisionTypeId").val("2");
		$("#decisionPersonsSection").hide();
		$("#countPerson").hide();

		openDecisionModal();
	}

	function printDecisionPdf(e,decisionId, type) {
		if (e) {
			e.preventDefault();
			e.stopPropagation();
		}
		const accId = parseInt($("#Id").val(), 10);

		if (type === 1) {
			window.open(
				url.PrintDecisionAccept + "?decisionId=" + decisionId + "&observerId=" + accId,
				"_blank"
			);
			return;
		}

		if (type === 2) {
			window.open(
				url.PrintDecisionReject + "?decisionId=" + decisionId + "&observerId=" + accId,
				"_blank"
			);
			return;
		}

		if (type === 3) {
			window.open(
				url.PrintDecisionOrganizationReject + "?decisionId=" + decisionId + "&observerId=" + accId,
				"_blank"
			);
		}
	}

		function getDecisionTypeFromReason() {
			const ddl = document.getElementById("IdReason")?.ej2_instances?.[0];
			const idReason = ddl ? parseInt(ddl.value, 10) : null;
			return idReason === 1 ? 1 : 2;
	}

		function municipalityFiltering(args) {

		var query = new ej.data.Query();

		if (args.text) {
			query = query.where("Name", "contains", args.text, true);
		}

		args.updateData(args.dataSource, query);
	}
	</script>