@using Microsoft.AspNetCore.Localization
@using Microsoft.AspNetCore.Mvc.Localization
@using Observers.Models
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject IViewLocalizer Localizer

@model Observers.Models.Data_AO
@{
	ViewData["Title"] = "e-Posmatrači";
	var requestCulture = Context.Features.Get<IRequestCultureFeature>();
	var defaultanimation = new Syncfusion.EJ2.Popups.DialogAnimationSettings { Effect = Syncfusion.EJ2.Popups.DialogEffect.FadeZoom };
	var resizeDirectionHandles = new List<string>() { "All" };
	var asyncSettingsIdentity = new Syncfusion.EJ2.Inputs.UploaderAsyncSettings { SaveUrl = @Url.Content("~/Dashboard/SaveIdentity"), RemoveUrl = @Url.Content("~/Dashboard/RemoveIdentity") };
	var asyncSettingsRequest = new Syncfusion.EJ2.Inputs.UploaderAsyncSettings { SaveUrl = @Url.Content("~/Dashboard/SaveRequest"), RemoveUrl = @Url.Content("~/Dashboard/RemoveRequest") };
	Message message = ViewBag.message;

	List<object> observerCommands = new List<object>();
	List<object> statusCommands = new List<object>();

	observerCommands.Clear();

	observerCommands.Add(new
	{
		type = "Izmjena",
		buttonOption = new
		{
			iconCss = "e-icons e-edit",
			cssClass = "e-flat btn-edit",
			title = "Izmjena"
		}
	});

	observerCommands.Add(new
	{
		type = "Brisanje",
		buttonOption = new
		{
			iconCss = "e-icons e-delete",
			cssClass = "e-flat btn-delete",
			title = "Brisanje"
		}
	});

	observerCommands.Add(new
	{
		type = "Status",
		buttonOption = new
		{
			iconCss = "e-icons e-info fa fa-user-check",
			cssClass = "e-flat btn-status",
			title = "Status"
		}
	});

	List<object> decisionDelete = new List<object>();
	decisionDelete.Add(new { type = "Delete", buttonOption = new { iconCss = "e-icons e-delete text-danger", cssClass = "e-flat text-danger" } });

	List<object> decisionPdfAccept = new List<object>();
	decisionPdfAccept.Add(new
	{
		type = "None",
		buttonOption = new
		{
			iconCss = "e-icons e-edit text-primary",
			cssClass = "e-flat text-primary cmd-decisionapprove"
		}
	});

	List<object> decisionPdfReject = new List<object>();
	decisionPdfReject.Add(new
	{
		type = "None",
		buttonOption = new
		{
			iconCss = "e-icons e-edit text-primary",
			cssClass = "e-flat text-primary cmd-decisionreject"
		}
	});

	if (requestCulture?.RequestCulture?.Culture?.Name == "bs-Cyrl-BA"
		&& !string.IsNullOrEmpty(message?.message))
	{
		message.message = Observers.Helpers.Converter
			.ConvertToCyrillic(message.message)
			.Replace("<бр />", "<br />");
	}
	var readonlyreason = true;
	@if (!User.IsInRole("CAND_Korisnik") && !User.IsInRole("OBS_Korisnik"))
	{
		readonlyreason = false;
	}
	
    var scopes = new List<object>();
	scopes.Add(new { Text = Localizer["Svi posmatrači"].Value, Value = "" });
	if (Model.CIK) { scopes.Add(new { Text = Localizer["A) Centralne izborne komisije BiH i Centar za brojanje glasova"].Value, Value = "CIK" }); }
	// if (Model.OIK) { scopes.Add(new { Text = Localizer["B) Rada izborne komisije"].Value, Value = "OIK" }); }
	// if (Model.CBS) { scopes.Add(new { Text = Localizer["C) Rada centra za birački spisak"].Value, Value = "CBS" }); }
	if (Model.BM) { scopes.Add(new { Text = Localizer["B) Izborna komisija, Centar za biračka mjesta i biračka mjesta"].Value, Value = "BM" }); }
	// if (Model.GCB) { scopes.Add(new { Text = Localizer["E) Rada Glavnog centra za brojanje"].Value, Value = "GCB" }); }
	if (Model.DKP) { scopes.Add(new { Text = Localizer["C) Biračka mjesta u diplomatsko-konzularnim prestavništvima"].Value, Value = "DKP" }); }
}



