	function commandClick(args) {

		const btn = args.target.closest('button');
		if (!btn) return;

		// ================= DELETE =================
		if (btn.classList.contains('btn-delete')) {

			bootbox.confirm({
				closeButton: false,
				title: "<div><i class='fa fa-exclamation-triangle text-red'></i> " + translations.Warning + "</div>",
				message: "<div>" + translations.AreYouSure + "</div>",
				buttons: {
					cancel: {
						label: '<i class="fa fa-check"></i> ' + translations.Cancel,
						className: 'btn-danger'
					},
					confirm: {
						label: '<i class="fa fa-times"></i> ' + translations.Delete,
						className: 'btn-success'
					}
				},
				callback: function(result) {
					if (result) {
						$.ajax({
							type: "POST",
							url: url.DeleteDataObserver,
							data: { id: args.rowData.Id }
						})
						.done(function(response) {
							var grid = document.getElementById("gridObservers").ej2_instances[0];
							grid.dataSource = response.observerPersons;
							grid.refresh();

							showMessage(translations.SaveDataTitle, translations.SuccessDelete, 'success');
						});
					}
				}
			});

			return;
		}

		// ================= EDIT =================
		if (btn.classList.contains('btn-edit')) {
		const row = args.rowData;
			$('#observerModal').modal('show');
			$("#observerHeaderTitle").text('@Localizer["Izmjena posmatrača"]');
		setObserverWarnings(!!row.IsDuplicate, !!row.IsCandidate);

		$("#ObserverPersonId").val(row.Id);
		$("#FirstName").val(row.FirstName);
		$("#LastName").val(row.LastName);
		$("#Jmbg").val(row.Jmbg ?? row.JMBG ?? "");
		$("#IdentityId").val(row.IdentityId ?? "");
		$("#Passport").val(row.Passport ?? "");

		$('input:radio[name=ObserverLanguage]').val([row.Language]);
		suppressObserverFilters = true;
		setObserverScopeForEdit(row);
		suppressObserverFilters = false;
		setObserverApprovalHeader(!!row.Approved, row.ReasonRejected);
		return;
	}

		// ================= STATUS =================
		if (btn.classList.contains('btn-status')) {

			$("#StatusObserverId").val(args.rowData.Id);
			$("#StatusApproved").prop("checked", !!args.rowData.Approved);

			var ddl = document.getElementById("StatusReasonId")?.ej2_instances?.[0];
			if (ddl) {
				ddl.value = args.rowData.IdReason ?? null;
				ddl.dataBind();
			}

			$("#observerStatusModal").modal("show");

			return;
		}
	}


	function getDataCbs() {

		var jmbg = document.getElementById("Jmbg").value;

		fetch('/Dashboard/GetDataCbs?jmbg=' + jmbg)
			.then(response => {
				if (!response.ok)
					throw new Error("Nema podataka");
				return response.json();
			})
			.then(data => {
				document.getElementById("FirstName").value = data.FirstName;
				document.getElementById("LastName").value = data.LastName;
			})
			.catch(err => {
				alert(err.message);
			});
	}


		document.querySelectorAll('a[data-toggle="tab"]').forEach(tab => {
		tab.addEventListener('shown.bs.tab', function () {

			var grid = document.getElementById("gridObservers")?.ej2_instances?.[0];
			if (grid) {
				grid.refresh();
			}

			var muni = document.getElementById("MunicipalityFilter")?.ej2_instances?.[0];
			if (muni) muni.refresh();

			var dkp = document.getElementById("DkpFilter")?.ej2_instances?.[0];
			if (dkp) dkp.refresh();
		});
	});

		function ObserverScopeChanged(args) {
			if (isEditModeScopeSet) return;
			clearDropdownInvalid("ObserverScope");

			const scope = args.value; 
			const skipGridFilter = args.skipGridFilter === true;
			const pnlMuni = document.getElementById("pnlFilterMunicipality");
			const pnlDkp  = document.getElementById("pnlFilterDkp");

			const muniDDL = document.getElementById("MunicipalityFilter")?.ej2_instances?.[0];
			const dkpDDL  = document.getElementById("DkpFilter")?.ej2_instances?.[0];

			const grid = document.getElementById("gridObservers")?.ej2_instances?.[0];

			if (pnlMuni) pnlMuni.style.display = "none";
			if (pnlDkp)  pnlDkp.style.display = "none";

			if (muniDDL) muniDDL.value = null;
			if (dkpDDL)  dkpDDL.value = null;

			if (!grid) return;

				if (skipGridFilter) {
			if (scope === "BM" && pnlMuni) pnlMuni.style.display = "";
			if (scope === "DKP" && pnlDkp) pnlDkp.style.display = "";
			return;
	}

		grid.clearFiltering();

		if (!scope) {
			grid.refresh();
			return;
		}

		if (scope === "BM") {
			if (pnlMuni) pnlMuni.style.display = "";
		} else if (scope === "DKP") {
			if (pnlDkp) pnlDkp.style.display = "";
		}

		switch (scope) {
			case "CIK": grid.filterByColumn("CIK", "equal", true); break;
			case "OIK": grid.filterByColumn("OIK", "equal", true); break;
			case "CBS": grid.filterByColumn("CBS", "equal", true); break;
			case "BM":  grid.filterByColumn("BM",  "equal", true); break;
			case "GCB": grid.filterByColumn("GCB", "equal", true); break;
			case "DKP": grid.filterByColumn("DKP", "equal", true); break;
		}
	}

	function ObserverFilterMuniChange(args) {
		// const grid = document.getElementById("gridObservers")?.ej2_instances?.[0];
		// if (!grid) return;

		// const val = args?.value;

		// if (!val) {
		// 	grid.removeFilteredColsByField("MunicipalitiesId");
		// 	return;
		// }

		// grid.filterByColumn("MunicipalitiesId", "equal", val*1);
	}

	function ObserverFilterDkpChange(args) {
		console.log(isEditModeScopeSet);
		if (isEditModeScopeSet) return;
		clearDropdownInvalid("DkpFilter");

		const grid = document.getElementById("gridObservers")?.ej2_instances?.[0];
		if (!grid) return;

		const val = args?.value;

		if (!val) {
			grid.removeFilteredColsByField("DkpId");
			return;
		}

		grid.filterByColumn("DkpId", "equal", val);
	}

	function getScopeFromRow(row) {
		if (row.Bm || row.BM) return "BM";
		if (row.Dkp || row.DKP) return "DKP";
		if (row.Cik || row.CIK) return "CIK";
		if (row.Oik || row.OIK) return "OIK";
		if (row.Cbs || row.CBS) return "CBS";
		if (row.Gcb || row.GCB) return "GCB";
		return "";
	}

	function setEjsDropdownValue(id, value) {
		const inst = document.getElementById(id)?.ej2_instances?.[0];
		if (!inst) return;

		inst.value = null;

		inst.value = value != null ? value.toString() : null;

		inst.dataBind();
	}

	function clearObserverFields() {

		const $ctx = $('#ObserverData');

		$ctx.find('#ObserverPersonId').val('');

		$ctx.find('#FirstName').val('');
		$ctx.find('#LastName').val('');
		$ctx.find('#Jmbg').val('');
		$ctx.find('#IdentityId').val('');
		$ctx.find('#PassportAndCountry').val('');
		$ctx.find('#ReasonRejected').val('');

		$ctx.find('input[name="ObserverLanguage"]').prop('checked', false);

		$ctx.find('#ObsPersonApproved').prop('checked', false);

		$('#dupliAcc').hide();
		$('#candAcc').hide();

		clearDropdownInvalid("ObserverScope");
		clearDropdownInvalid("MunicipalityFilter");
		clearDropdownInvalid("DkpFilter");

		if ($ctx.data('jqxValidator')) {
			$ctx.jqxValidator('hide');
		}

		setObserverWarnings(false, false);
	}

	function openDecisionModal() {
			const accId = parseInt($("#Id").val(), 10); // ili DecisionAccObserverId
			const decisionTypeId = getDecisionTypeFromReason();

			if (decisionTypeId === 2) {
				$("#decisionPersonsSection").hide();
				$("#decisionPersonInfo").hide();
			} else {
				$("#decisionPersonsSection").show();
				$("#decisionPersonInfo").show();
				bindDecisionPreviewGrid(accId);
			}
			showloader();

			$.ajax({
				url: url.GetNextDecisionInfo,
				type: "POST",
				data: { accreditationObserverId: accId }
			})
			.done(function(res){
				hideloader();

				if (res.status !== "Success") {
					showMessage(translations.SaveDataTitle, res.message || "Error", "danger");
					return;
				}

				$("#DecisionNumberPreview").val(res.decisionNumber);
				 $("#decisionPersonCount").text(res.numberOfPersons);

						 // Upozorenje ako nema nikog
		if (res.numberOfPersons === 0) {
			$("#decisionPersonInfo")
			  .removeClass("alert-info")
			  .addClass("alert-warning")
			  .html("<strong>Nema novih odobrenih posmatrača za ovu odluku.</strong>");
		} else {
			$("#decisionPersonInfo")
			  .removeClass("alert-warning")
			  .addClass("alert-info")
			  .html('<strong>Broj posmatrača koji će biti ovjereni ovom odlukom:</strong> <span id="decisionPersonCount">'+res.numberOfPersons+'</span>');
		}

		// Bind preview grid
		bindDecisionPreviewGrid(accId);

				$("#DecisionDate").val('');       // ili default today
				$("#SessionNumber").val('');

				$("#mdlDecision").modal("show");  // bootstrap 4/5 ovisno
			})
			.fail(function(xhr){
				hideloader();
				showMessage(translations.SaveDataTitle, "Server error", "danger");
			});
		}

		function saveDecision() {
			const accId = parseInt($("#Id").val(), 10);
			const decisionTypeId =  getDecisionTypeFromReason();
			const decisionDate = $("#DecisionDate").val();
			const sessionNumber = $("#SessionNumber").val();

			if (!decisionDate || !sessionNumber) {
				showMessage(translations.SaveDataTitle, translations.Required, "danger");
				return;
			}

			showloader();

			$.ajax({
				url: url.SaveDecision,
				type: "POST",
				contentType: "application/json; charset=utf-8",
				data: JSON.stringify({
					AccreditationObserverId: accId,
					DecisionDate: decisionDate,
					SessionNumber: sessionNumber,
					DecisionTypeId:decisionTypeId
				})
			})
			.done(function(res){
				hideloader();

				if (res.status !== "Success") {
					showMessage(translations.SaveDataTitle, res.message || "Error", "danger");
					return;
				}

				// refresh grid odluka
				const grid = document.getElementById("gridAODecisions")?.ej2_instances?.[0];
				if (grid) {
					grid.dataSource = res.decisions;
					grid.refresh();
				}

				$("#mdlDecision").modal("hide");
				showMessage(translations.SaveDataTitle, translations.Success, "success");
			})
			.fail(function(xhr){
				hideloader();
				showMessage(translations.SaveDataTitle, "Server error", "danger");
			});
		}

	function bindDecisionPreviewGrid(accId) {
		const grid = document.getElementById("gridDecisionPersonsPreview")?.ej2_instances?.[0];
		if (!grid) return;

		grid.dataSource = new ej.data.DataManager({
			url: url.GetDecisionPersonsPreview + "?accreditationObserverId=" + accId,
			adaptor: new ej.data.UrlAdaptor()
		});

		grid.query = new ej.data.Query();

		grid.refresh();
	}

