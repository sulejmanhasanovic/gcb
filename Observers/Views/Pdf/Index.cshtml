		</tr>
		<tr>
		<td class="cellgray w50">@Localizer["Aktivnost koja se posmatra: (navesti naziv i mjesto :CIK BiH/GCB, OIK/GIK/BM, DKP BiH)"]</td>
		<td class="cellwhite">@activitiesText</td>
		</tr>
</table>

