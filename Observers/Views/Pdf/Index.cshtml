<div style="width:100%; text-align:center"><h3>@Localizer["PODACI O PREDLOŽENIM POSMATRAČIMA"]</h3></div>
<br />


@{
	var activities = new List<string>();

	if (Model.main.CIK == true)
	{
		activities.Add(Localizer["CIK BiH/GCB"].Value);
	}

	if (Model.main.BM == true)
	{
		activities.Add(Localizer["OIK/GIK/BM"].Value);
	}

	if (Model.main.DKP == true)
	{
		activities.Add(Localizer["DKP BiH"].Value);
	}

	var activitiesText = string.Join(", ", activities);
}

<table style="width:100%">
			<tr>
