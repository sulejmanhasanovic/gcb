@using Microsoft.AspNetCore.Identity
@using System.Threading.Tasks
@using Microsoft.AspNetCore.Builder
@using Microsoft.AspNetCore.Localization
@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.Extensions.Options
@using Microsoft.AspNetCore.Http
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@inject IViewLocalizer Localizer

@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

@if (SignInManager.IsSignedIn(User))
{

	<li class="nav-item dropdown order-first order-lg-last">
		<a class="nav-link dropdown-toggle" data-toggle="dropdown" href="#" role="button" aria-haspopup="true" aria-expanded="false">
			<img id="id-navbar-user-image" class="d-none d-lg-inline-block radius-round border-2 brc-white-tp1 mr-2 w-6"
			 src="~/images/user.png" alt="Jason's Photo">
			<span class="d-inline-block d-lg-none d-xl-inline-block">
				<span class="text-90" id="id-user-welcome">@Localizer["Dobrodošli"],</span>
				<span class="nav-user-name">@UserManager.GetUserName(User)</span>
			</span>

			<i class="caret fa fa-angle-down d-none d-xl-block"></i>
			<i class="caret fa fa-angle-left d-block d-lg-none"></i>
		</a>

		<div class="dropdown-menu dropdown-caret dropdown-menu-right dropdown-animated brc-primary-m3 py-1">
			<div class="d-none d-lg-block d-xl-none">
				<div class="dropdown-header">
					@Localizer["Dobrodošli,"] @UserManager.GetUserName(User)
				</div>
				<div class="dropdown-divider"></div>
			</div>

			<form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Logout", "Dashboard", new { area = "" })" method="post" id="logoutForm">
				<button class="dropdown-item btn btn-outline-grey bgc-h-secondary-l3 btn-h-light-secondary btn-a-light-secondary logout" type="submit">
					<i class="fa fa-power-off text-warning-d1 text-105 mr-1"></i>
					@Localizer["Odjava"]
				</button>
			</form>
		</div>
	</li>
}
